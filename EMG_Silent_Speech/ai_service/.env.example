# Python AI inference service — example only (do not commit real secrets)

# Absolute or relative path to the active calibrated word model artefact.
# Production uses v6:
EMG_AI_MODEL_PATH=../training/results/calibrated_word_model_v6.npz

# Minimum inference window (must match Node backend; default 768).
# EMG_AI_MIN_PREDICT_SAMPLES=768

# Minimum neutral baseline samples for /session (default 80).
# EMG_AI_MIN_SESSION_SAMPLES=80

# In-memory model cache (1=enabled, 0=disabled).
# EMG_AI_CACHE_MODEL=1
