# Server environment variables (example only — do not commit real secrets)

PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=emg_mute_to_speech

# Email (Gmail SMTP via nodemailer service preset)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
OTP_EXPIRE_MINUTES=10

# Python AI inference service (calibrated word predictor)
# Start it with:
#   cd EMG_Silent_Speech
#   python -m uvicorn ai_service.app.main:app --host 127.0.0.1 --port 8077
AI_SERVICE_URL=http://127.0.0.1:8077

# AI timeouts (optional overrides)
# AI_SERVICE_HEALTH_TIMEOUT_MS=3000
# AI_SERVICE_PREDICT_TIMEOUT_MS=15000
# AI_SERVICE_SESSION_TIMEOUT_MS=10000

# Verified inference window. 768 is the smallest window that reproduces the
# verified Python result; do not lower it without re-measuring.
# AI_MIN_WINDOW_SAMPLES=768
# AI_MAX_WINDOW_SAMPLES=1800
# AI_MIN_SESSION_BASELINE_SAMPLES=80

# Rate limiting (optional overrides)
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_OTP_GENERATE_WINDOW_MS=900000
# RATE_LIMIT_OTP_GENERATE_MAX=5
# RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000
# RATE_LIMIT_OTP_VERIFY_MAX=15
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=30
