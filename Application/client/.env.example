# Backend API URL (must include /api suffix)

# Local development (Expo / Metro):
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Android emulator without adb reverse:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Physical Android device on the same Wi-Fi as your PC:
# Replace with your machine's LAN IPv4 address (ipconfig on Windows):
# EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:5000/api

# EMG simulation (development only)
# In __DEV__, simulation is enabled by default unless set to false.
# In production builds, simulation is disabled unless explicitly enabled.
# Keep this false whenever you are validating real ESP32 hardware, otherwise a
# development build can produce a full recording with no sensor attached.
EXPO_PUBLIC_ALLOW_EMG_SIMULATION=false

# EAS builds: set EXPO_PUBLIC_API_URL in the EAS project environment
# (Expo dashboard or `eas env:create`) for preview/production profiles.
# Do not commit device-specific LAN IPs into source control.
