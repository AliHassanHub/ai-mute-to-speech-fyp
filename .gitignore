# =============================================================================
# EMG Mute-to-Speech FYP — monorepo .gitignore
# =============================================================================

# --- Secrets / local environment ---
.env
.env.*
!.env.example
!.env.*.example

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# --- Expo / React Native / Metro ---
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Generated native project folders (regenerated by prebuild)
Application/client/android/
Application/client/ios/

# --- Android / iOS build artifacts ---
*.apk
*.aab
*.ipa
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.kotlin/

# --- Uploads / user-generated runtime data ---
Application/server/uploads/profile-images/*
!Application/server/uploads/profile-images/.gitkeep
Application/server/uploads/profile/*

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / temp ---
*.log
logs/
tmp/
temp/

# --- Arduino / embedded build cache ---
.arduino-build/

# --- Redundant archive copies at repo root ---
*.zip

# --- Certificates (never commit) ---
*.pem

# --- TypeScript build info ---
*.tsbuildinfo

# --- Optional local database dumps (see Database/backups/.gitignore) ---
# SQL/JSON backups under Database/backups/ are ignored by that folder's rules.
